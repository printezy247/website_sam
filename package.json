    "start:seed": "npm run db:migrate && npm run db:seed && next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
