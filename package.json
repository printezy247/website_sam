{
  "name": "website_sam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:migrate && npm run db:seed && next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "jobs": "tsx src/jobs.ts",
    "covers": "node tools/ebook-covers.mjs",
    "prebuild": "node tools/copy-pdf-worker.mjs",
    "predev": "node tools/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.42.0",
    "marked": "^18.0.12",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
